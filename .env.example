APP_ENV=development
APP_PORT=8000

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5442/data_room

LLM_PROVIDER=google
LLM_MODEL=gemini-3.6-flash
LLM_API_KEY=

EMBEDDING_PROVIDER=google
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=1536

MAX_INVESTIGATION_ITERATIONS=3
MAX_LLM_CALLS=30
MAX_INVESTIGATION_DURATION_SECONDS=900

INVESTIGATION_POLL_INTERVAL=10

DATA_ROOM_PATH=./data_room
